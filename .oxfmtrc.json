{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 4,
    "arrowParens": "avoid",
    "sortTailwindcss": {},
    "sortImports": true,
    "ignorePatterns": [
        "storybook-static/",
        "node_modules",
        "dist",
        ".vite-cache",
        ".output",
        ".nitro",
        "ui",
        "src/paraglide",
        "src/routeTree.gen.ts"
    ]
}
